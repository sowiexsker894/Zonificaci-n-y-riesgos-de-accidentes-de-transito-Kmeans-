{
  "info": {
    "name": "PC4 - API Siniestros K-Means",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "sin_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health (API, Postgres, Redis, nodos)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/health",
          "host": [
            "{{base}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Latencia < 100 ms', ()=>pm.expect(pm.response.responseTime).to.be.below(100));",
              "pm.test('Status 200', ()=>pm.response.to.have.status(200));",
              "pm.test('3 nodos activos', ()=>pm.expect(pm.response.json().nodos_activos).to.eql(3));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login (JWT)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/login",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"admin\",\n  \"clave\": \"admin123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Latencia < 100 ms', ()=>pm.expect(pm.response.responseTime).to.be.below(100));",
              "pm.test('Status 200', ()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
